{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/out-tsc/spec",
    "types": ["vitest/globals", "node"],
    "typeRoots": ["node_modules/@types", "node_modules"],
    "module": "es2022",
    "noImplicitAny": false,
    "noImplicitThis": false
  },
  "include": ["src/**/*.spec.ts", "tests/**/*.ts", "src/**/*.d.ts"]
}
